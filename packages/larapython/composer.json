{
    "name": "larapython/engine",
    "description": "Unified Laravel-Python Integration Engine for background tasks, Boost MCP, and microservices.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hassan-Razhei",
            "email": "hasaanmohammed019@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/process": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "laravel/prompts": "^0.1|^0.2|^0.3"
    },
    "autoload": {
        "psr-4": {
            "LaraPython\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraPython\\LaraPythonServiceProvider"
            ],
            "aliases": {
                "Python": "LaraPython\\Facades\\Python"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

