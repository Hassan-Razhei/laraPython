{
    "name": "hassan-razhei/entity-streamer",
    "description": "High-performance RFC 7233 partial content HTTP 206 video and audio streaming engine for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "streaming",
        "rfc-7233",
        "http-206",
        "partial-content",
        "video-streaming",
        "audio-streaming",
        "flysystem",
        "signed-urls"
    ],
    "authors": [
        {
            "name": "Hassan-Razhei",
            "email": "hasaanmohammed019@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "symfony/http-foundation": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "EntityStreamer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EntityStreamer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EntityStreamer\\StreamerServiceProvider"
            ],
            "aliases": {
                "Streamer": "EntityStreamer\\Facades\\Streamer"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
